{
  "name": "@lhlyu/pi-kit",
  "version": "0.2.1",
  "description": "Pi Coding Agent 的模型自动发现与终端状态栏扩展",
  "type": "module",
  "license": "MIT",
  "author": "lhlyu",
  "homepage": "https://github.com/lhlyu/pi-kit#readme",
  "bugs": {
    "url": "https://github.com/lhlyu/pi-kit/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lhlyu/pi-kit.git"
  },
  "keywords": [
    "pi-package",
    "pi-extension"
  ],
  "files": [
    "src/",
    "docs/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "pi": {
    "extensions": [
      "./src/status-extension.ts",
      "./src/discovery-extension.ts"
    ]
  },
  "scripts": {
    "dev": "pi --extension ./src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"tests/**/*.test.ts\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run typecheck && npm test",
    "prepack": "npm run check"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=1.3.0",
    "@earendil-works/pi-coding-agent": ">=1.3.0",
    "typebox": "^1.3.0"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@types/node": "^22.20.5",
    "@types/write-file-atomic": "^4.0.3",
    "prettier": "^3.9.10",
    "typebox": "1.3.27",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "jsonc-parser": "^3.3.1",
    "write-file-atomic": "^7.0.1"
  }
}
