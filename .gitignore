# Dependencies and package manager caches
node_modules/
.npm/
.pnpm-store/
.yarn/
.pnp.*

# Build output and TypeScript cache
dist/
build/
*.tsbuildinfo
*.tgz

# Test output and tool caches
coverage/
.nyc_output/
.cache/
.eslintcache

# Logs and diagnostic reports
logs/
*.log
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Local environment and secrets
.env
.env.*
!.env.example

# Local Pi runtime/configuration (may contain credentials or private endpoints)
.pi/

# Local examples
/examples/

# Temporary files
tmp/
temp/
*.tmp
*.swp
*.swo
*~

# Editor and OS files
.idea/
.vscode/
.DS_Store
Thumbs.db

# Keep package-lock.json tracked for reproducible installs.
